# ETL pipeline configuration. Copy to .env and fill in. .env is gitignored.
# The old lowercase names (dbname, host, port, user, password,
# aws_access_key_id, aws_secret_access_key_id) are still accepted.

REDSHIFT_DB=
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_USER=
REDSHIFT_PASSWORD=
CONNECT_TIMEOUT_SECONDS=30

# Destination. Was hardcoded to a bootcamp bucket and a personal key.
S3_BUCKET=
S3_KEY=etl/online_transactions_cleaned.csv

# Optional. When unset, boto3's default credential chain is used (instance
# role, profile, environment) -- what a container on AWS wants.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

LOG_LEVEL=INFO
